# ============================================================
# Aceh Discovery — contoh konfigurasi / example configuration
# Salin jadi .env:  cp .env.example .env
# Lalu jalankan:    php artisan key:generate
# ============================================================

APP_NAME="Aceh Discovery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# GANTI DI SINI: sesuaikan dengan nama folder project di Herd (mis. http://aceh-discovery.test)
APP_URL=http://aceh-discovery.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database MariaDB / MariaDB database
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
# GANTI DI SINI: nama database, user, dan password lokal kamu
DB_DATABASE=aceh_discovery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Video & poster beranda (URL publik) / Homepage videos (public URLs)
HERO_VIDEO_URL=https://res.cloudinary.com/ojm5bajr/video/upload/v1792901029/hero-beranda.mp4
HERO_POSTER_URL=https://media.istockphoto.com/id/1361564380/id/foto/baiturrahman-grand-mosque.jpg?s=2048x2048&w=is&k=20&c=yIcv0CetGBU4wP8BPc-p8X5a1xRBKJOE9yevfkOB25s=
EDITORIAL_TARI_SAMAN_VIDEO_URL=https://res.cloudinary.com/ojm5bajr/video/upload/v1792901073/tari-saman.mp4
EDITORIAL_KOPI_GAYO_VIDEO_URL=https://res.cloudinary.com/ojm5bajr/video/upload/v1792901070/kopi-gayo.mp4
EDITORIAL_RUMOH_ACEH_VIDEO_URL=https://res.cloudinary.com/ojm5bajr/video/upload/v1792901072/rumoh-aceh.mp4
EDITORIAL_SABANG_VIDEO_URL=https://res.cloudinary.com/ojm5bajr/video/upload/v1792901071/sabang.mp4

# Media sosial / Social media handles
SOSIAL_INSTAGRAM=acehdiscovery.id
SOSIAL_YOUTUBE=acehdiscovery
SOSIAL_TIKTOK=acehdiscovery.id
SOSIAL_FACEBOOK="Aceh Discovery"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
